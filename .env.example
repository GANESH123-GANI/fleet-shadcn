# ==============================================================================
# Fleet OS Environment Configuration Template
# Copy this file to .env and populate with secure values.
# NEVER commit .env to version control!
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# API Server Port
API_PORT=3001
PORT=3001

# JWT Secret Key
# In production, this MUST be a cryptographically secure random string with at least 32 characters (256-bit entropy).
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_key!

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleetos

# Allowed CORS Origins (comma-separated for multiple origins)
# Example: https://fleetos-web-six.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://fleetos-web-six.vercel.app

# Web App Public API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Storage Driver ('local' | 's3')
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# AWS / S3 Configuration (if using S3 driver or AWS Cognito)
# AWS_REGION=ap-south-1
# EVIDENCE_BUCKET=fleetos-evidence

# AI Assistant API Keys (Optional)
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...

# Notifications (Optional)
# WHATSAPP_API_KEY=...
# WHATSAPP_PHONE_NUMBER_ID=...
# TWILIO_ACCOUNT_SID=...
# TWILIO_FROM_NUMBER=...
